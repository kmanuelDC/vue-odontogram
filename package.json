{
  "name": "@kmanueldc/vue-odontogram",
  "version": "0.1.1",
  "description": "Vue 3 dental chart component library",
  "license": "MIT",
  "type": "module",
  "main": "./dist/vue-odontogram.umd.cjs",
  "module": "./dist/vue-odontogram.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-odontogram.js",
      "require": "./dist/vue-odontogram.umd.cjs"
    },
    "./style.css": "./dist/vue-odontogram.css"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && vue-tsc -p tsconfig.publish.json --emitDeclarationOnly",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --config vite.config.ts --dir tests",
    "dev:playground": "vite --config playground/vite.config.ts",
    "build:playground": "vite build --config playground/vite.config.ts"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.9",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  },
  "author": "Manuel Díaz",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kmanuelDC/vue-odontogram.git"
  },
  "homepage": "https://github.com/kmanuelDC/vue-odontogram#readme",
  "bugs": {
    "url": "https://github.com/kmanuelDC/vue-odontogram/issues"
  }
}
